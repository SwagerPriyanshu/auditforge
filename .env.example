# ==============================================================================
# AuditForge Environment Configuration
# =====================================
# Copy this file to .env and configure for your environment
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# Model Provider (OpenAI-Compatible Endpoint)
# ------------------------------------------------------------------------------
# OPTION 1: NVIDIA NIM (https://build.nvidia.com/models)
OPENAI_API_KEY=nvapi-your-nvidia-api-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.3-70b-instruct

# OPTION 2: OpenAI (Uncomment if using official OpenAI)
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# MCP Tool Integrations & External Services
# ------------------------------------------------------------------------------
# GitHub MCP (for searching repos, PRs, and commit history)
GITHUB_TOKEN=

# Sandbox Execution (Daytona isolated container runner)
DAYTONA_API_KEY=

# TrueForge Harness Gateway (if running TrueForge daemon separately)
TRUEFORGE_URL=http://localhost:8790
TRUEFORGE_API_KEY=

# ------------------------------------------------------------------------------
# Storage & Workspace Paths
# ------------------------------------------------------------------------------
# SQLite Audit Database (WebAssembly / sql.js)
AUDIT_DB_PATH=./data/audit.db

# Filesystem Tool Target Directory
DATA_DIR=./data/workspace
